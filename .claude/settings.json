{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/check.py)",
      "Bash(python scripts/check.py *)",
      "Bash(backend/.venv/Scripts/python.exe -m pytest *)",
      "Bash(backend/.venv/Scripts/python.exe -m ruff check *)",
      "Bash(git add *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(aws *)",
      "PowerShell(aws *)",
      "Bash(sam *)",
      "Bash(cdk *)",
      "Bash(terraform *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "PowerShell(Remove-Item *)",
      "Bash(git push)",
      "PowerShell(git push)",
      "PowerShell(git commit *)",
      "PowerShell(sam *)",
      "PowerShell(cdk *)",
      "PowerShell(terraform *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "Bash(python -m pip install *)",
      "PowerShell(python -m pip install *)",
      "Bash(backend/.venv/Scripts/python.exe -m pip install *)",
      "PowerShell(backend/.venv/Scripts/python.exe -m pip install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(rm -fr *)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "PowerShell(git add -f*)",
      "PowerShell(git add --force*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/stop_hook.py"
            ],
            "timeout": 300,
            "statusMessage": "品質チェック (scripts/check.py) を検証中..."
          }
        ]
      }
    ]
  }
}
